{
  "name": "hyperplayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HyperPlayer — 现代化 Windows 桌面音乐播放器（Tauri 2 + React/TS + Rust 引擎）",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm prepare-sidecar && tauri build",
    "build:debug": "pnpm prepare-sidecar && tauri build --debug --no-bundle",
    "sidecar": "node server/netease-sidecar.mjs",
    "prepare-sidecar": "node scripts/prepare-sidecar-dist.mjs",
    "build:hse": "node scripts/build-hse.mjs",
    "frontend:dev": "pnpm build:hse && vite --host 127.0.0.1",
    "frontend:build": "pnpm build:hse && pnpm check:ipc && tsc -b && vite build",
    "check:ipc": "node app/bridge/verify-contract.mjs",
    "test": "pnpm build:hse && vitest run"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.102.8",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-http": "^2.6.0",
    "animejs": "4.5.0",
    "buffer": "^6.0.3",
    "crypto-js": "^4.2.0",
    "hypersoundengine": "link:shared/hypersoundengine",
    "lucide-react": "^1.40.0",
    "motion": "^12.23.24",
    "node-forge": "^1.4.0",
    "pako": "^3.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.4.0",
    "@types/pako": "^3.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
