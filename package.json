{
  "name": "waveforge",
  "productName": "WaveForge 澜音工坊",
  "version": "0.1.4",
  "description": "沉浸式音乐播放器，支持网易云和QQ音乐",
  "author": "WaveForge",
  "type": "module",
  "main": "desktop/main.cjs",
  "private": true,
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build:apple-weather": "node scripts/build-apple-weather-scenes.mjs",
    "build": "vite build",
    "gen:installer-art": "node scripts/generate-installer-art.mjs",
    "preview:setup": "node scripts/preview-setup.mjs",
    "build:electron": "npm run build:electron:dir && node scripts/generate-installer-art.mjs && node scripts/generate-installer-ui.mjs && electron-builder --prepackaged release/win-unpacked --win nsis --publish never",
    "build:electron:dir": "node scripts/assert-release-not-running.cjs && npm run build && electron-builder --win dir --publish never && npm run vmp:sign:release && npm run vmp:verify:release && npm run vmp:status:release",
    "build:electron:dir:unsigned": "node scripts/assert-release-not-running.cjs && npm run build && electron-builder --win dir --publish never",
    "vmp:sign:dev": "node scripts/evs-vmp.cjs sign-pkg node_modules/electron/dist",
    "vmp:verify:dev": "node scripts/evs-vmp.cjs verify-pkg node_modules/electron/dist",
    "vmp:sign:release": "node scripts/evs-vmp.cjs sign-pkg release/win-unpacked",
    "vmp:verify:release": "node scripts/evs-vmp.cjs verify-pkg release/win-unpacked",
    "vmp:status:release": "node scripts/write-vmp-status.cjs release/win-unpacked",
    "start": "electron .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:chroma": "node scripts/test-chroma.cjs && node scripts/test-razer-device-discovery.cjs && node scripts/test-chroma-app-list-repair.cjs",
    "test:signalrgb": "node scripts/test-signalrgb.cjs && node scripts/test-signalrgb-effect.cjs",
    "benchmark:mv": "node scripts/bilibili-mv-benchmark.mjs",
    "test:desktop": "node --test test/apple-url-policy.test.cjs test/audio-download-security.test.cjs test/audio-download-policy.test.cjs test/local-api-health.test.mjs test/taskbar-widget-polling.test.cjs test/trusted-ipc.test.cjs test/update-manager-security.test.cjs test/user-data-profile.test.cjs test/vmp-status.test.cjs test/vmp-status-wiring.test.cjs",
    "lint": "tsc --noEmit",
    "prebuild": "node scripts/build-v3-worklet.mjs",
    "test:installer": "node scripts/generate-installer-ui.mjs && node --test test/installer.test.cjs",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major",
    "version:pre": "node scripts/bump-version.mjs pre",
    "version:dry": "node scripts/bump-version.mjs --dry-run",
    "build:v3-worklet": "node scripts/build-v3-worklet.mjs",
    "predev": "node scripts/build-v3-worklet.mjs",
    "predev:electron": "node scripts/build-v3-worklet.mjs"
  },
  "build": {
    "appId": "com.waveforge.desktop",
    "productName": "WaveForge 澜音工坊",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "server/**/*",
      "shared/**/*",
      "python-apple-bridge/**/*",
      "local-server.mjs",
      "THIRD_PARTY_NOTICES.md",
      "package.json",
      "logo.png",
      "build/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "python-apple-bridge/**/*.py"
    ],
    "win": {
      "icon": "build/icon.ico",
      "executableName": "WaveForge 澜音工坊",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "WaveForge 澜音工坊",
      "artifactName": "WaveForge-${version}-Setup.${ext}"
    }
  },
  "dependencies": {
    "@jixun/qmweb-sign": "^2.0.3",
    "@neteasecloudmusicapienhanced/api": "^4.39.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@soundtouchjs/audio-worklet": "^2.1.1",
    "@svg-maps/world": "^2.0.0",
    "@tanstack/react-virtual": "^3.14.10",
    "adm-zip": "^0.6.0",
    "china-area-data": "^5.0.1",
    "compression": "^1.8.1",
    "country-state-city": "^3.2.1",
    "dotenv": "^17.2.3",
    "express": "^4.22.2",
    "framer-motion": "^12.40.0",
    "hls.js": "^1.7.1",
    "lamejs": "^1.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "opencc-js": "^1.0.5",
    "pixi.js": "^8.20.0",
    "qq-music-api": "^1.1.2",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-window": "^2.3.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "github:castlabs/electron-releases#v42.8.0+wvcus",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "heic-decode": "^2.1.0",
    "jsdom": "^29.1.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "qq-music-api": {
      "axios": "^1.19.0",
      "express": "^4.22.2",
      "morgan": "^1.11.0",
      "xml2js": "^0.6.2",
      "jade": {
        "clean-css": "^4.1.11",
        "constantinople": "^3.1.2",
        "transformers": {
          "uglify-js": "^2.8.29"
        }
      },
      "useragent": "npm:useragent-ng@2.4.5"
    }
  }
}
