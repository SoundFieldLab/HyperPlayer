{
  "name": "hyperplayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HyperPlayer — 现代化 Windows 桌面音乐播放器（Tauri 2 + React/TS + Rust 引擎）",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:debug": "tauri build --debug --no-bundle",
    "frontend:dev": "vite --host 127.0.0.1",
    "frontend:build": "pnpm check:ipc && pnpm check:hse-destination && tsc -b && vite build",
    "check:ipc": "node app/bridge/verify-contract.mjs",
    "check:hse-source": "node provenance/hse-v1.5.1/verify-source-manifest.mjs",
    "check:hse-destination": "node scripts/verify-hse-destination-manifest.mjs",
    "check:hse-vendor": "pnpm check:hse-source && pnpm check:hse-destination",
    "update:hse-destination": "node scripts/verify-hse-destination-manifest.mjs --update",
    "check:hse-ts": "tsc -p shared/hse-ts-core/tsconfig.json --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.102.8",
    "@tauri-apps/api": "^2.11.1",
    "motion": "^12.23.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
