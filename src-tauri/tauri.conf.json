{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HyperPlayer",
  "version": "0.1.0",
  "identifier": "com.hyperplayer.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @hyperplayer/app dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @hyperplayer/app build",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "HyperPlayer",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$MUSIC/**", "$DOWNLOAD/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/SoundFieldLab/HyperPlayer/releases/latest/download/{{target}}-{{arch}}-{{version}}"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFQkU0ODc4QzYwOEUxOTcKUldTWDRRakdlRWkrTGpveVB5bFBuRVJrY0RST25NL1BkV2VWZHVwRk5lR1k3M240cjFVRlNvbjcK"
    }
  }
}
